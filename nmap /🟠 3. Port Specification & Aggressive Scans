nmap -p 80,443,22 <TARGET-IP>    # Specific Ports: Scans only the designated ports.
nmap -p- <TARGET-IP>             # All Ports: Scans all 65,535 TCP ports. (Time-consuming but thorough).
nmap --top-ports 100 <TARGET-IP> # Top Ports: Scans only the 100 most commonly used ports.
nmap -F <TARGET-IP>              # Fast Scan: Scans the top 100 ports (faster than the default top 1000).
nmap -A <TARGET-IP>              # Aggressive Scan: The "Loud & Proud" scan. Enables OS detection (-O), version scanning (-sV), script scanning (-sC), and traceroute.
